      <aliases enabled='yes' />
      <column caption='ROMI' datatype='real' name='[Calculation_1413424822398976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_revenue_7d]) - SUM([spend])) / IIF(SUM([spend]) = 0, NULL, SUM([spend]))' />
      </column>
      <column caption='CVR (Device)' datatype='real' name='[Calculation_1413424894873601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payers_count (Devices)]) / SUM([user_count (Devices)])' />
      </column>
      <column caption='ARPU (Device)' datatype='real' name='[Calculation_1413424894943234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_revenue_7d (Devices)]) / SUM([user_count (Devices)])' />
      </column>
      <column caption='Month Filter' datatype='boolean' name='[Calculation_1477196458188801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, DATE([date])) = DATEADD(&apos;month&apos;, -[Parameters].[Parameter 2], DATETRUNC(&apos;month&apos;, TODAY()))' />
      </column>
      <column caption='Spend MoM %' datatype='real' name='[Calculation_1477196459102210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([spend]) - LOOKUP(SUM([spend]), -1)) / ABS(LOOKUP(SUM([spend]), -1))'>
          <table-calc level-address='[federated.1ypekxw1nd37fr1fjto1h18eadew].[mn:date:ok]' ordering-field='[federated.1ypekxw1nd37fr1fjto1h18eadew].[date]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='ROAS' datatype='real' name='[Calculation_2924703256129536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;7d&quot;&#13;&#10;THEN ZN(SUM([total_revenue_7d])) / IIF(SUM([spend]) = 0, NULL, SUM([spend]))&#13;&#10;ELSE ZN(SUM([total_revenue_90d])) / IIF(SUM([spend]) = 0, NULL, SUM([spend]))&#13;&#10;END' />
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_2924703256477698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payers_count])/SUM([user_count])' />
      </column>
      <column caption='CAC' datatype='real' name='[Calculation_2924703256588291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([spend])/SUM([user_count])' />
      </column>
      <column caption='ARPU_7D' datatype='real' name='[Calculation_2924703256682500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_revenue_7d])/SUM([user_count])' />
      </column>
      <column caption='ARPU_90D' datatype='real' name='[Calculation_2924703256784901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_revenue_90d])/SUM([user_count])' />
      </column>
      <column caption='Month' datatype='date' default-format='*mmmm yyyy' name='[Date (copy)_1477196457525248]' role='dimension' type='ordinal'>
