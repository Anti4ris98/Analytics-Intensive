    <worksheet name='Sheet 9'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>ROAS by Channel</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Marketing_report' name='federated.1ypekxw1nd37fr1fjto1h18eadew' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='March 2026' caption='Month Offset' datatype='integer' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='April 2026' />
                <alias key='2' value='March 2026' />
                <alias key='3' value='February 2026' />
                <alias key='4' value='January 2026' />
                <alias key='5' value='December 2025' />
                <alias key='6' value='November 2025' />
                <alias key='7' value='October 2025' />
              </aliases>
            </column>
            <column alias='ROAS 7 Days' caption='Revenue Window' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;7d&quot;'>
              <calculation class='tableau' formula='&quot;7d&quot;' />
              <aliases>
                <alias key='&quot;7d&quot;' value='ROAS 7 Days' />
                <alias key='&quot;90d&quot;' value='ROAS 90 Days' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ypekxw1nd37fr1fjto1h18eadew'>
            <column caption='Month Filter' datatype='boolean' name='[Calculation_1477196458188801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, DATE([date])) = DATEADD(&apos;month&apos;, -[Parameters].[Parameter 2], DATETRUNC(&apos;month&apos;, TODAY()))' />
            </column>
            <column caption='ROAS' datatype='real' name='[Calculation_2924703256129536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;7d&quot;&#13;&#10;THEN ZN(SUM([total_revenue_7d])) / IIF(SUM([spend]) = 0, NULL, SUM([spend]))&#13;&#10;ELSE ZN(SUM([total_revenue_90d])) / IIF(SUM([spend]) = 0, NULL, SUM([spend]))&#13;&#10;END' />
            </column>
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
